# Every variable is optional. Bun loads a `.env` file automatically.

# Where the database and uploaded media live (default: ./data, or /data in Docker).
# SIDEDISPLAY_DATA_DIR=./data

# Address to listen on (defaults: 0.0.0.0 and 4380).
# SIDEDISPLAY_HOST=0.0.0.0
# SIDEDISPLAY_PORT=4380

# Sets the admin password at every start, instead of the first-run screen.
# Handy for unattended deployments; leave unset to manage it in the UI.
# SIDEDISPLAY_PASSWORD=

# Home Assistant connection. The Settings page can set this too, and wins if
# both are present. Not needed when running as a Home Assistant app.
# SIDEDISPLAY_HA_URL=http://homeassistant.local:8123
# SIDEDISPLAY_HA_TOKEN=

# MQTT broker, for the MQTT elements (mqtts:// for TLS). The Settings page can
# set this too, and wins if both are present.
# SIDEDISPLAY_MQTT_URL=mqtt://192.168.1.10:1883
# SIDEDISPLAY_MQTT_USERNAME=
# SIDEDISPLAY_MQTT_PASSWORD=

# Largest upload accepted, in megabytes (default 500).
# SIDEDISPLAY_MAX_UPLOAD_MB=500
